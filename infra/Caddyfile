# Proxy reverso do app (HTTPS automático via Let's Encrypt).
#
# O app monta canonical/sitemap/og:image a partir de X-Forwarded-Proto/Host e
# usa X-Forwarded-For (que o Caddy sobrescreve) no limite de requisições por
# IP — o reverse_proxy do Caddy já envia os três por padrão; não remova.
#
# Pré-requisito do certificado: o DNS de www.diastransporte.site tem que
# apontar SÓ pra esta VPS (179.197.74.90). Um segundo registro A (ex.: o do
# Lovable, 185.158.133.1) faz parte das validações caírem no outro servidor.

www.diastransporte.site {
	encode zstd gzip

	# Arquivos de public/ (fotos da frota, ícones) não têm hash no nome, então o app
	# não os marca como cacheáveis; 7 dias evita rebaixar as fotos a cada visita.
	# /assets/* (com hash) o próprio app já serve como immutable por 1 ano.
	@estaticos path /frota/* /icon-*.png /apple-touch-icon.png /favicon.png
	header @estaticos Cache-Control "public, max-age=604800"

	reverse_proxy app:3000
}

# Quando o registro A do domínio sem "www" (@) também apontar pra VPS, descomente
# pra redirecionar para o endereço principal (www):
# diastransporte.site {
# 	redir https://www.diastransporte.site{uri} permanent
# }

# car-fleet-co (backoffice de despacho) roda num container à parte, do outro
# projeto docker-compose nesta mesma VPS — este Caddy não está na rede dele,
# então em vez de reverse_proxy por nome de serviço, aponta pro IP público +
# porta publicada (179.197.74.90:3001), via hairpin NAT do próprio Docker.
# Só faz sentido enquanto o car-fleet-co existir (ele está sendo aposentado
# pela fusão).
# painel.diastransporte.site {
# 	reverse_proxy 179.197.74.90:3001
# }
