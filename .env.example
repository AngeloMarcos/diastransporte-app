# -------------------------------------------------------------------------
# Deploy próprio (VPS). No Lovable Cloud estas variáveis não são usadas.
# Copie para .env na VPS: cp .env.example .env
# -------------------------------------------------------------------------

# Postgres do container (role de MIGRATION / DDL)
POSTGRES_DB=dias
POSTGRES_USER=dias_migration
POSTGRES_PASSWORD=troque-esta-senha

# Usada pelas migrations (DDL)
DATABASE_URL_MIGRATION=postgres://dias_migration:troque-esta-senha@db:5432/dias

# Usada pelo runtime do app (role de APP, só CRUD — criada por 0002_roles.sql)
DATABASE_URL=postgres://dias_app:troque-esta-senha-do-app@db:5432/dias

# Chave de assinatura de sessão. Gere com: openssl rand -hex 32
SESSION_SECRET=

# URL pública do site (usada para marcar o cookie como Secure)
APP_URL=https://seudominio.com.br

# Onde as fotos ficam no disco (volume do compose)
UPLOADS_DIR=/var/lib/dias-transporte/uploads

# Login próprio + Postgres da VPS
VITE_AUTH_MODE=vps

# Senha provisória dos admins na primeira carga (db/criar-admins.mjs)
ADMIN_SENHA_INICIAL=

# Integração com o car-fleet-co (backoffice de despacho), mesma VPS — ver o
# roteiro "Despacho Unificado", Sprint 3. Em branco = integração desligada
# (notificação de nova reserva é pulada em silêncio, checkout funciona igual).
# CARFLEET_INTEGRACAO_TOKEN precisa ser o MESMO valor configurado como
# INTEGRACAO_DIAS_TRANSPORTE_TOKEN no .env do car-fleet-co.
CARFLEET_API_URL=http://179.197.74.90:3001
CARFLEET_INTEGRACAO_TOKEN=
