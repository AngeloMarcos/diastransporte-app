# -------------------------------------------------------------------------
# Deploy próprio (VPS). No Supabase Cloud (Lovable) estas variáveis não são
# usadas. Copie para .env na VPS: cp .env.example .env
# -------------------------------------------------------------------------

# Postgres do container (role de MIGRATION / DDL)
POSTGRES_DB=carfleet
POSTGRES_USER=carfleet_migration
POSTGRES_PASSWORD=troque-esta-senha

# Usada pelas migrations (DDL)
DATABASE_URL_MIGRATION=postgres://carfleet_migration:troque-esta-senha@db:5432/carfleet

# Usada pelo runtime do app (role de APP, só CRUD — criada por 0002_roles.sql)
DATABASE_URL=postgres://carfleet_app:troque-esta-senha-do-app@db:5432/carfleet

# Chave de assinatura de sessão. Gere com: openssl rand -hex 32
SESSION_SECRET=

# URL pública do site (usada para marcar o cookie como Secure)
APP_URL=https://seudominio.com.br

# Login próprio + Postgres da VPS
VITE_AUTH_MODE=vps

# Senha provisória dos admins na primeira carga (db/criar-admins.mjs) —
# aqui os e-mails vêm por argumento, não há lista fixa como no Dias Transporte
ADMIN_SENHA_INICIAL=

# Token fixo que o Dias Transporte usa para chamar POST /api/integracoes/
# dias-transporte (server-a-servidor, sem sessão). Gere com: openssl rand -hex 32
# Precisa ser o MESMO valor configurado como CARFLEET_INTEGRACAO_TOKEN no
# .env do Dias Transporte. Em branco = integração desligada (401 sempre).
INTEGRACAO_DIAS_TRANSPORTE_TOKEN=
